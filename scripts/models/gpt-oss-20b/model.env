# gpt-oss-20b -- canonical settings for every sweep script in this directory.
#
# These are the values the published numbers were produced with. Changing one
# makes your run something other than a reproduction, which is fine, but say so
# when you report it.
#
# Every setting here yields to the environment, so a one-off change needs no edit:
#   EP_GEN_DATASETS=gsm8k bash scripts/run.sh <model> fixedk --gpus 0,1

EP_MODEL_NAME="${EP_MODEL_NAME:-gpt-oss-20b}"
EP_HF_REPO="${EP_HF_REPO:-openai/gpt-oss-20b}"
EP_ENVIRONMENT="${EP_ENVIRONMENT:-expertpruning}"          # which install script's environment this needs

# Architecture, for reference in the scripts and in error messages.
EP_NATIVE_K="${EP_NATIVE_K:-4}"        # experts the router selects per token, unpruned
EP_NUM_EXPERTS="${EP_NUM_EXPERTS:-32}"      # routed experts per layer
EP_NUM_LAYERS="${EP_NUM_LAYERS:-24}"

# What to evaluate.
EP_GEN_DATASETS="${EP_GEN_DATASETS:-mmlu_pro,gpqa:diamond,math_500,aime24_avg,aime25_avg,lcb:codegeneration_v6,gsm8k,hellaswag_fixed,livebench_20241125}"
EP_QA_TASKS="${EP_QA_TASKS:-arc_challenge,arc_easy,winogrande,openbookqa}"

# Decoding and engine.
EP_MAX_MODEL_LEN="${EP_MAX_MODEL_LEN:-32768}"
EP_MAX_NEW_TOKENS="${EP_MAX_NEW_TOKENS:-32768}"
EP_TEMPERATURE="${EP_TEMPERATURE:-0.7}"
EP_TOP_P="${EP_TOP_P:-0.8}"
EP_TOP_K="${EP_TOP_K:-20}"
EP_GPU_MEM_UTIL="${EP_GPU_MEM_UTIL:-0.9}"
EP_TP="${EP_TP:-2}"                    # tensor parallel; overridden by --gpus

# Ban measures each layer's sensitivity by pruning to this k and watching the
# output distribution move, so it is a property of the model rather than a speed
# knob. This is the value the published artifact for this model used.
EP_CALIB_BAN_K_PRUNED="${EP_CALIB_BAN_K_PRUNED:-2}"
# Quantized: expert selection is inlined into the compiled region, so a run that
# keeps CUDA graphs cannot count its own experts. Forcing eager to get the count
# costs 6.7x in generation throughput here (166 against 1138 tok/s), the difference
# between a day and two weeks. So scores come from a graph run and the average
# expert count from probe.sh, a separate eager pass. Under CUDA graphs vLLM also
# pads each batch to a captured size, and those padding rows would be miscounted,
# which makes the probe the more correct place to measure it anyway.
EP_ROUTER_EXEC_MODE="${EP_ROUTER_EXEC_MODE:---allow_compiled_router}"

# --smoke overrides, for checking the plumbing without spending GPU hours.
EP_SMOKE_SAMPLES="${EP_SMOKE_SAMPLES:-4}"
EP_SMOKE_NEW_TOKENS="${EP_SMOKE_NEW_TOKENS:-512}"
EP_SMOKE_MODEL_LEN="${EP_SMOKE_MODEL_LEN:-4096}"
